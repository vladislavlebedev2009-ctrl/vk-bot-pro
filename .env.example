# Пример конфигурации VK Bot PRO 2.0.
# Скопируй этот файл в .env и заполни реальные значения.
# Файл .env НЕ должен попадать в Git (.env добавлен в .gitignore).

# Обязательно: токен доступа сообщества VK (БЕЗ префикса, просто сам токен)
VK_TOKEN=your_vk_group_access_token_here

# ID сообщества (группы VK) — это же сообщество является основной
# (и единственной) целью для публикаций командой /post (VK API wall.post).
# Токен сообщества должен иметь право на публикацию на стене.
VK_GROUP_ID=200588798

# VK ID владельца бота (Вождь клуба)
VK_PATRON_ID=497479649

# Версия VK API
VK_API_VERSION=5.199

# Ожидание Long Poll (секунды, 1-90)
VK_LONGPOLL_WAIT=25

# Путь к SQLite-файлу (относительный — от рабочей директории)
VK_DB_PATH=bot.db

# Таймаут HTTP-запросов к VK API (секунды)
VK_HTTP_TIMEOUT=20

# Таймаут незавершённой регистрации (секунды)
VK_REGISTRATION_TIMEOUT_SEC=600

# Задержка перед переподключением Long Poll после ошибки (мс)
VK_LONGPOLL_RECONNECT_DELAY_MS=5000

# === VK BOT PRO 2.0 ===

# Префикс команд бота (по умолчанию "/")
VK_COMMAND_PREFIX=/

# Лимит команд за окно (VK_RATE_LIMIT_WINDOW_SEC) для обычного пользователя
VK_RATE_LIMIT=25

# Лимит команд за окно для администраторов (Вождь клуба и Член Президиума и выше)
VK_RATE_LIMIT_ADMIN=60

# Окно rate limit (секунды)
VK_RATE_LIMIT_WINDOW_SEC=60

# Кулдаун выдачи репутации одним пользователем другой цели (секунды)
VK_REP_COOLDOWN_SEC=3600

# Интервал проверки истечения временных наказаний (секунды)
VK_TEMP_PUNISHMENT_INTERVAL_SEC=60

# Размер TOP-выдачи (также страница списка /users)
VK_TOP_LIMIT=10

# Кулдаун повторного запуска ОДНОЙ И ТОЙ ЖЕ команды (секунды)
VK_COMMAND_COOLDOWN_SEC=3

# Тот же кулдаун для администраторов (Вождь клуба и Член Президиума и выше)
VK_ADMIN_COMMAND_COOLDOWN_SEC=1

# === DISCORD (JDA) ===
# Discord-бот — попутный сервис: при любых его ошибках VK-бот работает.
# Команды Discord-бота используют ту же базу и систему званий.

# Включить Discord-бота (true/false). По умолчанию false.
DISCORD_ENABLED=false

# Токен Discord-бота (https://discord.com/developers/applications).
# Токен обязан быть в .env/окружении и никогда не попадать в Git.
DISCORD_TOKEN=

# ID сервера (guild), на котором будут зарегистрированы slash-команды.
# Бот должен быть добавлен на этот сервер.
DISCORD_GUILD_ID=